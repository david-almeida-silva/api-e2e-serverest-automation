  "item": [
    {
      "name": "Usuarios",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"dynamic_email\", \"qa\" + Date.now() + \"@teste.com\");"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"David Silva QA\",\r\n  \"email\": \"{{dynamic_email}}\",\r\n  \"password\": \"teste\",\r\n  \"administrador\": \"true\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/usuarios",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "usuarios"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\nlet resposta = pm.response.json();\r\n\r\nlet tokenLimpo = resposta.authorization.replace(\"Bearer \", \"\");\r\n\r\npm.environment.set(\"auth_token\", tokenLimpo);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"{{dynamic_email}}\",\r\n  \"password\": \"teste\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Produto Restrito",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.environment.set(\"dynamic_product\", \"Notebook \" + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 201 Created\", function () {\r\n    pm.response.to.have.status(201);\r\n});\r\nlet resposta = pm.response.json();\r\npm.environment.set(\"id_produto\", resposta._id);"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{auth_token}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"{{dynamic_product}}\",\r\n  \"preco\": 4500,\r\n  \"descricao\": \"Produto automatizado\",\r\n  \"quantidade\": 10\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/produtos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "produtos"
          ]
        }
      },
      "response": []
    },
    {
      "name": "Consultar Produto",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status 200 OK\", function () {\r\n    pm.response.to.have.status(200);\r\n});\r\n\r\npm.test(\"Valida integridade do nome do produto\", function () {\r\n    let resposta = pm.response.json();\r\n    // Pega o nome que geramos e salvamos no momento da criação\r\n    let nomeGerado = pm.environment.get(\"dynamic_product\");\r\n    \r\n    // Compara se o nome que voltou da API é igual ao que geramos\r\n    pm.expect(resposta.nome).to.eql(nomeGerado);\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/produtos/{{id_produto}}",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "produtos",
            "{{id_produto}}"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[Negativo] Login com Senha Incorreta",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code é 401 Unauthorized\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Valida mensagem de erro de autenticação\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.message).to.eql(\"Email e/ou senha inválidos\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"email\": \"fulano@qa.com\",\r\n  \"password\": \"senha_totalmente_errada\"\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/login",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "login"
          ]
        }
      },
      "response": []
    },
    {
      "name": "[Negativo] Criar Produto Sem Token",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Status code é 401 Unauthorized para requisição sem token\", function () {\r\n    pm.response.to.have.status(401);\r\n});\r\n\r\npm.test(\"Valida mensagem de ausência de token de autorização\", function () {\r\n    var jsonData = pm.response.json();\r\n    pm.expect(jsonData.message).to.eql(\"Token de acesso ausente, inválido, expirado ou em formato indevido\");\r\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "raw",
          "raw": "{\r\n  \"nome\": \"Produto Sem Auth\",\r\n  \"preco\": 100,\r\n  \"descricao\": \"Teste de segurança\",\r\n  \"quantidade\": 10\r\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/produtos",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "produtos"
          ]
        }
      },
      "response": []
    }
  ]
